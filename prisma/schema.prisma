generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  phoneNumber   Int?      @map("phone_number")
  bio           String?
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// --- Catalogue mode ---

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  season      String? // ex: "Printemps-Été 2027"
  description String?
  coverImage  String?   @map("cover_image")
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("collection")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("category")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  basePrice    Decimal        @map("base_price") @db.Decimal(10, 2)
  status       ProductStatus  @default(DRAFT)
  collectionId String?        @map("collection_id")
  collection   Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  categoryId   String?        @map("category_id")
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([collectionId])
  @@index([categoryId])
  @@index([status])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  size          String? // XS, S, M, L, XL ou pointure
  color         String?
  colorHex      String?  @map("color_hex")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  stock         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variant")
}
