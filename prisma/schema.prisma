generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  phoneNumber   Int?      @map("phone_number")
  bio           String?
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  pushSubscriptions PushSubscription[]
  payoutsRecorded   PayoutRecord[]
  reviews           Review[]
  supportTickets    SupportTicket[]  @relation("SupportTicketBuyer")
  supportMessages   SupportMessage[] @relation("SupportMessageAuthor")

  // Compte staff rattache a une boutique (role "vendeur"). NULL = staff
  // plateforme (viewer/editor/admin), voit toutes les boutiques.
  boutiqueId    String?   @map("boutique_id")
  boutique      Boutique? @relation("BoutiqueStaff", fields: [boutiqueId], references: [id], onDelete: SetNull)
  ownedBoutique Boutique? @relation("BoutiqueOwner")

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@index([boutiqueId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

// --- Boutiques (multi-tenant Pixel) ---

enum BoutiqueStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DeliveryFeeMode {
  INCLUS                 // ajoute au montant paye en ligne
  A_LA_CHARGE_DU_CLIENT   // paye separement, en especes, a la reception
}

// Une boutique = une vendeuse TikTok. Le branding (ex-StoreSettings) est
// duplique ici plutot que dans une table a part : meme acteur, meme cadence
// d'edition que le reste de la fiche boutique.
model Boutique {
  id          String         @id @default(cuid())
  handle      String         @unique
  displayName String         @map("display_name")
  status      BoutiqueStatus @default(PENDING)

  ownerId String @unique @map("owner_id")
  owner   User   @relation("BoutiqueOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  staff   User[] @relation("BoutiqueStaff")

  // Localisation : sert a suggerer les agences de livraison pertinentes
  // (Agence.zones) au moment d'assigner une livraison.
  pays     String  @default("Bénin")
  ville    String
  quartier String?
  adresse  String?

  // Certaines vendeuses ont leur propre service de livraison et facturent
  // un tarif ; d'autres laissent la livraison a la charge du client (payee
  // en especes a la reception, hors paiement en ligne). Valeur par defaut
  // (0, a la charge du client) au moment ou une boutique est creee et
  // n'a encore rien configure.
  deliveryFee     Decimal         @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliveryFeeMode DeliveryFeeMode @default(A_LA_CHARGE_DU_CLIENT) @map("delivery_fee_mode")
  // Texte libre écrit par la vendeuse elle-même (zones couvertes, délai,
  // comment ça se passe) — pas de système de zones structuré/annuaire de
  // communes : elle gère sa livraison à sa façon, le client la paie hors
  // plateforme (déjà le cas par défaut via deliveryFeeMode). Affiché au
  // checkout et sur la page boutique.
  deliveryDetails String?         @map("delivery_details")

  accentColor  String  @default("#a67c52") @map("accent_color")
  heroEyebrow  String? @map("hero_eyebrow")
  heroTitle    String? @map("hero_title")
  heroSubtitle String? @map("hero_subtitle")
  heroCtaLabel String? @map("hero_cta_label")
  bio          String?
  logoUrl      String? @map("logo_url")
  coverImage   String? @map("cover_image")
  currency     String  @default("XOF")

  featuredCollectionId String?     @map("featured_collection_id")
  featuredCollection   Collection? @relation("BoutiqueFeaturedCollection", fields: [featuredCollectionId], references: [id], onDelete: SetNull)

  // Numéro affiché aux acheteuses pour un contact direct (distinct de
  // socialWhatsapp : peut être un numéro d'appel classique, pas forcément
  // WhatsApp). Éditable par la vendeuse elle-même (voir requireBoutiqueAccess
  // dans updateBoutiqueContact), contrairement au reste de la fiche boutique
  // qui reste admin-only en v1.
  savPhone        String? @map("sav_phone")
  socialFacebook  String? @map("social_facebook")
  socialInstagram String? @map("social_instagram")
  socialTiktok    String? @map("social_tiktok")
  socialWhatsapp  String? @map("social_whatsapp")
  legalMentions   String? @map("legal_mentions")
  cgvContent      String? @map("cgv_content")
  trustBadges     Json?   @map("trust_badges")

  products    Product[]
  collections Collection[] @relation("BoutiqueCollections")
  orders         Order[]
  payouts        PayoutRecord[]
  reviews        Review[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([ville])
  @@map("boutique")
}

// --- Livraison / agences partenaires ---

enum LivraisonStatus {
  A_ASSIGNER
  PRISE_EN_CHARGE
  EN_ROUTE
  LIVREE
  ECHEC
  RETOUR
}

model Agence {
  id         String      @id @default(cuid())
  name       String
  phone      String?
  zones      String[]
  isActive   Boolean     @default(true) @map("is_active")
  livraisons Livraison[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("agence")
}

// Cycle de vie separe de OrderStatus : le paiement est arbitre par le
// webhook GeniusPay, la livraison est saisie manuellement par le
// staff/la vendeuse (aucune agence n'a d'integration aujourd'hui).
model Livraison {
  id           String          @id @default(cuid())
  orderId      String          @unique @map("order_id")
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agenceId     String?         @map("agence_id")
  agence       Agence?         @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  status       LivraisonStatus @default(A_ASSIGNER)
  trackingCode String?         @map("tracking_code")
  notes        String?
  proofUrl     String?         @map("proof_url")
  assignedAt   DateTime?       @map("assigned_at")
  deliveredAt  DateTime?       @map("delivered_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([agenceId])
  @@map("livraison")
}

// Grand livre interne (pas un vrai sequestre) : l'argent continue de
// transiter par GeniusPay vers le compte plateforme, ces lignes ne font que
// tracer ce qui a ete reellement reverse a chaque vendeuse en dehors de
// l'app. Le solde du (getWalletSummary) se calcule a partir des
// OrderItem des commandes PAID moins la somme de ces PayoutRecord — jamais
// stocke directement, pour eviter toute desynchronisation. Cree uniquement
// par un admin (jamais la vendeuse elle-meme) : regle d'integrite pour
// qu'un solde ne puisse pas etre falsifie de l'interieur.
model PayoutRecord {
  id           String   @id @default(cuid())
  boutiqueId   String   @map("boutique_id")
  boutique     Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("XOF")
  method       String
  reference    String?
  note         String?
  recordedById String   @map("recorded_by_id")
  recordedBy   User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([boutiqueId])
  @@map("payout_record")
}

// --- Catalogue mode ---

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Collection {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  season         String? // ex: "Printemps-Été 2027"
  description    String?
  coverImage     String?         @map("cover_image")
  isActive       Boolean         @default(true) @map("is_active")
  boutiqueId     String          @map("boutique_id")
  boutique       Boutique        @relation("BoutiqueCollections", fields: [boutiqueId], references: [id], onDelete: Restrict)
  products       Product[]
  featuredBy     StoreSettings[]
  featuredByBoutique Boutique[]  @relation("BoutiqueFeaturedCollection")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([boutiqueId])
  @@map("collection")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("category")
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  basePrice    Decimal        @map("base_price") @db.Decimal(10, 2)
  status       ProductStatus  @default(DRAFT)
  boutiqueId   String         @map("boutique_id")
  boutique     Boutique       @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  collectionId String?        @map("collection_id")
  collection   Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  categoryId   String?        @map("category_id")
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([boutiqueId])
  @@index([collectionId])
  @@index([categoryId])
  @@index([status])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@map("product_image")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String      @map("product_id")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique
  size          String? // XS, S, M, L, XL ou pointure
  color         String?
  colorHex      String?     @map("color_hex")
  priceOverride Decimal?    @map("price_override") @db.Decimal(10, 2)
  stock         Int         @default(0)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variant")
}

// --- Commandes & paiements ---

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  boutiqueId    String      @map("boutique_id")
  boutique      Boutique    @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String      @map("customer_name")
  customerEmail String?     @map("customer_email")
  customerPhone String      @map("customer_phone")
  country       String      @default("CI")
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency      String      @default("XOF")
  // Copie des reglages boutique au moment de la commande (pas une
  // reference live) : si la vendeuse change son tarif plus tard, les
  // commandes deja passees gardent ce qui a ete annonce a l'acheteur.
  deliveryFee     Decimal         @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliveryFeeMode DeliveryFeeMode @default(A_LA_CHARGE_DU_CLIENT) @map("delivery_fee_mode")
  items         OrderItem[]
  payments      Payment[]
  livraison     Livraison?
  review        Review?
  supportTicket SupportTicket?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([boutiqueId])
  @@index([status])
  @@index([userId])
  @@index([country])
  // Filtre le plus fréquent du code (portefeuille, dashboard, exports) :
  // "commandes PAID de cette boutique" — un index composite sert cette
  // requête directement plutôt que de laisser Postgres combiner deux index
  // simples.
  @@index([boutiqueId, status])
  @@map("order")
}

// Un avis par commande (contrainte unique sur orderId), uniquement possible
// une fois la Livraison au statut LIVREE — vérifié côté action, pas en
// contrainte DB (le statut peut encore changer après coup, ex: RETOUR).
// Nécessite un compte acheteur (Order.userId non nul) : pas d'avis anonyme
// pour une commande invitée.
model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  boutiqueId String   @map("boutique_id")
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([boutiqueId])
  @@map("review")
}

enum SupportTicketStatus {
  OUVERT
  EN_COURS
  RESOLU
  FERME
}

// Ticket SAV rattache a une boutique comme une commande (Restrict, meme
// raison que Order.boutique). Toujours cree par une acheteuse connectee
// (pas de ticket anonyme — cf Review, et le fallback email
// support@bloko.me existe deja pour une visiteuse non connectee) donc
// userId est requis, Cascade comme Review.userId (meme compromis deja
// fait par Review : l'historique SAV ne survit pas a la suppression du
// compte — coherent puisque userId porte aussi le controle d'acces cote
// acheteuse).
// orderId est unique : un seul ticket par commande.
model SupportTicket {
  id         String              @id @default(cuid())
  boutiqueId String              @map("boutique_id")
  boutique   Boutique            @relation(fields: [boutiqueId], references: [id], onDelete: Restrict)
  userId     String              @map("user_id")
  user       User                @relation("SupportTicketBuyer", fields: [userId], references: [id], onDelete: Cascade)
  orderId    String              @unique @map("order_id")
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subject    String
  status     SupportTicketStatus @default(OUVERT)
  messages   SupportMessage[]
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@index([boutiqueId, status])
  @@index([userId])
  @@map("support_ticket")
}

// Un message par intervention (acheteuse ou staff). isStaff est fige au
// moment de l'envoi (pas recalcule depuis le role actuel de authorId)
// pour que l'historique reste correct meme si le compte change de role
// plus tard. authorId est nullable + SetNull — contrairement a
// SupportTicket.userId — parce que c'est le ticket, pas le message, qui
// porte le controle d'acces : un message doit pouvoir survivre a la
// suppression de son auteur, meme compromis que Order.userId.
model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?       @map("author_id")
  author    User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  isStaff   Boolean       @default(false) @map("is_staff")
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_message")
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String         @map("order_id")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  unitPrice        Decimal        @map("unit_price") @db.Decimal(10, 2)

  @@index([orderId])
  @@map("order_item")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("geniuspay")
  reference     String        @unique
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("XOF")
  checkoutUrl   String?       @map("checkout_url")
  paymentMethod String?       @map("payment_method")
  rawPayload    Json?         @map("raw_payload")
  expiresAt     DateTime?     @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("payment")
}

// --- Parametres plateforme (singleton, id fixe "default") ---
// Ex-parametres "boutique unique", repositionnes comme reglages de l'accueil
// Pixel (marque plateforme) depuis le passage au multi-boutiques. Les
// champs de branding par boutique vivent desormais sur Boutique (ci-dessus).

model StoreSettings {
  id                   String      @id @default("default")
  storeName            String      @default("Mode Shop") @map("store_name")
  currency             String      @default("XOF")
  accentColor          String      @default("#a67c52") @map("accent_color")
  heroEyebrow          String      @default("Nouvelle collection") @map("hero_eyebrow")
  heroTitle            String      @default("Le prêt-à-porter, pensé pour vous") @map("hero_title")
  heroSubtitle         String      @default("Des pièces sélectionnées, livrées depuis Cotonou et Abidjan.") @map("hero_subtitle")
  heroCtaLabel         String      @default("Découvrir la boutique") @map("hero_cta_label")
  featuredCollectionId String?     @map("featured_collection_id")
  featuredCollection   Collection? @relation(fields: [featuredCollectionId], references: [id], onDelete: SetNull)
  socialFacebook       String?     @map("social_facebook")
  socialInstagram      String?     @map("social_instagram")
  socialTiktok         String?     @map("social_tiktok")
  socialWhatsapp       String?     @map("social_whatsapp")
  legalMentions        String?     @map("legal_mentions")
  cgvContent           String?     @map("cgv_content")
  trustBadges          Json?       @map("trust_badges")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@map("store_settings")
}

// --- Abonnements push (staff uniquement, notif nouvelles commandes) ---

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscription")
}
